{
  "/api/v2/robot/capabilities/MopDockSelfCleanManualTriggerCapability": {
    "put": {
      "tags": [
        "MopDockSelfCleanManualTriggerCapability"
      ],
      "summary": "Mop Dock Self-Clean Manual trigger",
      "description": "Start and Stop the self-cleaning of the dock itself (e.g. its wash tray), as opposed to cleaning the mop pads",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "description": "Mop Dock self-clean action to perform",
                  "enum": [
                    "start",
                    "stop"
                  ]
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "$ref": "#/components/responses/200"
        },
        "400": {
          "$ref": "#/components/responses/400"
        }
      }
    }
  },
  "/api/v2/robot/capabilities/MopDockSelfCleanManualTriggerCapability/properties": {
    "get": {
      "tags": [
        "MopDockSelfCleanManualTriggerCapability"
      ],
      "summary": "Get various capability-related properties",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
